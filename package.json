{
   "name": "order-event-platform",
   "version": "1.0.0",
   "private": true,
   "workspaces": [
      "shared",
      "services/*",
      "tests/e2e"
   ],
   "scripts": {
      "dev": "concurrently -n auth,inventory -c blue,green \"npm run dev --workspace=@order-event-platform/auth-service\" \"npm run dev --workspace=@order-event-platform/inventory-service\"",
      "test": "npm run test --workspaces --if-present",
      "test:integration": "npm run test:integration --workspaces --if-present",
      "test:e2e": "npm run test --workspace=@order-event-platform/e2e-tests",
      "build": "npm run build --workspaces --if-present",
      "dev:auth": "npm run dev --workspace=@order-event-platform/auth-service",
      "dev:inventory": "npm run dev --workspace=@order-event-platform/inventory-service",
      "lint": "eslint ."
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "concurrently": "^10.0.4",
      "eslint": "^10.6.0",
      "eslint-plugin-n": "^18.2.1",
      "globals": "^17.7.0"
   }
}
